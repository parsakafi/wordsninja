{
  "name": "wordsninja",
  "version": "2.0.1",
  "description": "Split an English string that has no spaces into words. Zero dependencies, offset-aware, with custom dictionaries and TypeScript types.",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "index.d.mts",
    "words-en.json",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/wordsninja.test.js test/robustness.test.js",
    "test:watch": "node --test --watch test/wordsninja.test.js test/robustness.test.js",
    "build:dictionary": "node scripts/build-dictionary.js",
    "bench": "node bench/bench.js",
    "bench:accuracy": "node bench/accuracy.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "split",
    "text",
    "sentence",
    "english",
    "ninja",
    "words",
    "word",
    "splitter",
    "tokenizer",
    "tokenize",
    "segmentation",
    "text-segmentation",
    "word-segmentation",
    "wordninja",
    "no-spaces",
    "capitalize",
    "camelcase",
    "camel-case"
  ],
  "author": "Parsa Kafi <parselearn@gmail.com> (https://parsa.ws)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parsakafi/wordsninja.git"
  },
  "bugs": {
    "url": "https://github.com/parsakafi/wordsninja/issues"
  },
  "homepage": "https://parsa.ws/projects/wordsninja-js-package"
}
